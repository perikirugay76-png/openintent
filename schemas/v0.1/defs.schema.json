{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.dev/schemas/v0.1/defs.schema.json",
  "title": "OpenIntent v0.1 Shared Definitions",
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["person", "organization", "agent", "service", "project"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "constraint": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": ["equals", "not_equals", "contains", "in", "not_in", ">", ">=", "<", "<="]
        },
        "value": {},
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "preference": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
