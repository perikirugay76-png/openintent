{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.dev/schemas/v0.1/consent-policy.schema.json",
  "title": "ConsentPolicy",
  "type": "object",
  "required": [
    "type",
    "version",
    "visibility",
    "can_store",
    "can_forward",
    "can_contact_matches",
    "requires_human_approval"
  ],
  "properties": {
    "type": {
      "const": "ConsentPolicy"
    },
    "version": {
      "const": "0.1"
    },
    "visibility": {
      "enum": ["private", "shared", "public"]
    },
    "can_store": {
      "type": "boolean"
    },
    "can_forward": {
      "type": "boolean"
    },
    "can_contact_matches": {
      "type": "boolean"
    },
    "requires_human_approval": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
