{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.dev/schemas/v0.1/capability-card.schema.json",
  "title": "CapabilityCard",
  "type": "object",
  "required": ["type", "version", "id", "actor", "capability", "terms"],
  "properties": {
    "type": {
      "const": "CapabilityCard"
    },
    "version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "defs.schema.json#/$defs/actor"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "terms": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["summary", "category", "constraints", "preferences"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/constraint"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/preference"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
