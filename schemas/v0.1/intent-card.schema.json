{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openintent.dev/schemas/v0.1/intent-card.schema.json",
  "title": "IntentCard",
  "type": "object",
  "required": ["type", "version", "id", "actor", "intent", "consent"],
  "properties": {
    "type": {
      "const": "IntentCard"
    },
    "version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "defs.schema.json#/$defs/actor"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "consent": {
      "$ref": "#/$defs/consent"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": ["summary", "category", "constraints", "preferences"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/constraint"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/preference"
          }
        }
      },
      "additionalProperties": true
    },
    "consent": {
      "type": "object",
      "required": [
        "visibility",
        "can_store",
        "can_forward",
        "can_contact_matches",
        "requires_human_approval"
      ],
      "properties": {
        "visibility": {
          "enum": ["private", "shared", "public"]
        },
        "can_store": {
          "type": "boolean"
        },
        "can_forward": {
          "type": "boolean"
        },
        "can_contact_matches": {
          "type": "boolean"
        },
        "requires_human_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
